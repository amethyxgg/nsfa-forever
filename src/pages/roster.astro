---
import type { Character } from '../wow-forever-data/types/Character';
import Page from '../layouts/Page.astro';

import roster from '../data/roster';


const mains = roster.flatMap((player: any) => {
    const character = player.characters?.[0];

    return character
        ? [{ player, character }]
        : [];
});

const alts = roster.flatMap((player: any) =>
    (player.characters ?? [])
        .slice(1)
        .map((character: Character) => ({ player, character }))
);

---

<Page>
    <style>
        .grid-8 {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 0.5rem;
        }

        .roster {
            display: grid;
            grid-template-columns: repeat(8, minmax(0, 1fr));
            gap: 0.5rem;
        }

        .roster-character {
            border: 3px solid var(--theme-bg-darkest);
            border-radius: 16px;
            padding: 0.5rem;
            min-width: 0;
        }
    </style>

    <h1>Roster</h1>

    <main>
        <section class="roster">
            {mains.map(({ player, character }) => (
                <div class="roster-character">
                    <p class={`fg-${character.wowclass.css}`}>
                        {character.name}
                    </p>

                        <p class="text-sm">
                            Level {character.level} <span class={`fg-${character.wowclass.css}`}>
                                {character.wowclass.name}
                            </span>
                        </p>

                        <p class={`text-sm fg-${player.rank.toLowerCase()}`}>
                            {player.player}
                        </p>
                    </div>
                ))
            }
        </section>

        <section class="alts">
            {alts.map(({ player, character }) => (
                <div class="roster-character">
                    <p class={`fg-${character.wowclass.css}`}>
                        {character.name}
                    </p>

                        <p class="text-sm">
                            Level {character.level} {character.wowclass.name}
                        </p>

                        <p class="text-xs">
                            {player.player}
                        </p>
                    </div>
                ))
            }
        </section>
    </main>
</Page>
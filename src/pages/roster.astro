---
import type { Character } from '../wow-forever-data/types/Character';
import wowClasses from '../wow-forever-data/data/classes';
import Page from '../layouts/Page.astro';

import roster from '../data/roster';


const mains = roster.flatMap((player: any) => {
    const character = player.characters?.[0];

    return character
        ? [{ player, character }]
        : [];
});

const alts = roster.flatMap((player: any) =>
    (player.characters ?? [])
        .slice(1)
        .map((character: Character) => ({ player, character }))
);

const classes = Object.values(wowClasses).sort((a, b) => a.name.localeCompare(b.name));

---

<Page>
    <style>
        .grid-8 {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 0.5rem;
        }

        .roster {
            display: grid;
            grid-template-columns: repeat(8, minmax(0, 1fr));
            gap: 0.5rem;
        }

        .roster-character {
            border: 3px solid var(--theme-bg-darkest);
            border-radius: 16px;
            padding: 0.5rem;
            min-width: 0;
        }

        .roster-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .roster-filters input,
        .roster-filters select {
            padding: 0.5rem 0.75rem;
        }

        .roster-filters input {
            flex: 1 1 16rem;
        }

        .roster-filters select {
            flex: 0 1 12rem;
        }

        .alts {
            margin-top: 0.5rem;
        }

        .is-hidden {
            display: none;
        }
    </style>

    <h1>Roster</h1>

    <main>
        <div class="roster-filters" aria-label="Roster filters">
            <input id="roster-search" type="search" placeholder="Search character or player" aria-label="Search character or player" />
            <select id="class-filter" aria-label="Filter by character class">
                <option value="">All classes</option>
                {classes.map((wowclass) => <option value={wowclass.name}>{wowclass.name}</option>)}
            </select>
        </div>

        <h1>Mains</h1>
        <section class="roster" data-roster-section>
            
            {mains.map(({ player, character }) => (
                <div class="roster-character" data-roster-character data-character-name={character.name} data-player-name={player.player} data-character-class={character.wowclass.name}>
                    <p class={`fg-${character.wowclass.css}`}>
                        {character.name}
                    </p>

                        <p class="text-sm">
                            Level {character.level} <span class={`fg-${character.wowclass.css}`}>
                                {character.wowclass.name}
                            </span>
                        </p>

                        <p class={`text-sm fg-${player.rank.toLowerCase()}`}>
                            {player.player}
                        </p>
                    </div>
                ))
            }
        </section>

        <h1>Alts</h1>
        <section class="roster" data-roster-section>
            {alts.map(({ player, character }) => (
                <div class="roster-character" data-roster-character data-character-name={character.name} data-player-name={player.player} data-character-class={character.wowclass.name}>
                    <p class={`fg-${character.wowclass.css}`}>
                        {character.name}
                    </p>

                        <p class="text-sm">
                            Level {character.level} <span class={`fg-${character.wowclass.css}`}>
                                {character.wowclass.name}
                            </span>
                        </p>

                        <p class={`text-sm fg-${player.rank.toLowerCase()}`}>
                            {player.player}
                        </p>
                    </div>
                ))
            }
        </section>
        <p id="roster-empty" class="is-hidden" aria-live="polite">No characters match your search.</p>
    </main>
</Page>

<script>
    const search = document.querySelector<HTMLInputElement>('#roster-search');
    const classFilter = document.querySelector<HTMLSelectElement>('#class-filter');
    const characters = document.querySelectorAll<HTMLElement>('[data-roster-character]');
    const sections = document.querySelectorAll<HTMLElement>('[data-roster-section]');
    const emptyMessage = document.querySelector<HTMLElement>('#roster-empty');

    const filterRoster = () => {
        const query = search?.value.trim().toLowerCase() ?? '';
        const selectedClass = classFilter?.value ?? '';
        let visibleCharacters = 0;

        characters.forEach((character) => {
            const matchesSearch = !query
                || character.dataset.characterName?.toLowerCase().includes(query)
                || character.dataset.playerName?.toLowerCase().includes(query);
            const matchesClass = !selectedClass || character.dataset.characterClass === selectedClass;
            const isVisible = matchesSearch && matchesClass;

            character.classList.toggle('is-hidden', !isVisible);
            if (isVisible) visibleCharacters += 1;
        });

        sections.forEach((section) => {
            section.classList.toggle('is-hidden', !section.querySelector('[data-roster-character]:not(.is-hidden)'));
        });
        emptyMessage?.classList.toggle('is-hidden', visibleCharacters > 0);
    };

    search?.addEventListener('input', filterRoster);
    classFilter?.addEventListener('change', filterRoster);
</script>
